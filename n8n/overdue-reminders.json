{
  "name": "LendLoop, daily overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "eca5304c-2cf1-4d05-90c5-619b5b921c1f",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CONVEX_SITE_URL }}/automation/overdue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.N8N_READ_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "6de9b6ae-f7ef-4557-b48f-18b942cc8ea2",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "9b62fccf-8e23-48f2-8b36-2f8b8276758c",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One reminder per loan per day. The reminderId is the idempotency key the\n// Convex side checks, so a retried run never writes a second record.\nconst day = new Date().toISOString().slice(0, 10);\nreturn $input.all().map((item) => {\n  const l = item.json;\n  console.log(`[reminder] to ${l.borrower.name} <${l.borrower.email}>: the ${l.tool} was due back on ${l.endDate}, ${l.daysOverdue} day(s) ago.`);\n  return { json: { payload: { loanId: l.loanId, reminderId: `${l.loanId}:${day}`, channel: 'log' } } };\n});"
      },
      "id": "6fdd9ae1-1810-479a-a22e-8964e46ed652",
      "name": "Send reminder (logged mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign an outgoing write-back for Convex. Secret from the container env,\n// never from this file. Signature = HMAC-SHA256(secret, `${ts}.${body}`).\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nif (!secret) throw new Error('LENDLOOP_WEBHOOK_SECRET is not set');\nreturn $input.all().map((item) => {\n  const body = JSON.stringify(item.json.payload);\n  const ts = String(Math.floor(Date.now() / 1000));\n  const sig = crypto.createHmac('sha256', secret).update(`${ts}.${body}`).digest('hex');\n  return { json: { body, ts, sig: `sha256=${sig}` } };\n});"
      },
      "id": "c3cb8ec1-ac3d-4e75-9f7b-a4400659bc3b",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/automation/reminder-sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "cc7f36d6-c5bc-4db9-b248-4cf128bdca1a",
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (logged mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (logged mock)": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}